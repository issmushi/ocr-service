# API
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Модели и профиль запуска
OCR_MODELS=paddle,mrz,russian-ocr
OCR_RUNTIME_PROFILE=cpu
OCR_DEVICE=cpu
RUSSIAN_OCR_DEVICE=cpu
RUSSIAN_OCR_MODELS_DIR=storage/models/russian-docs-ocr/4.6.1/models
# Для установки без интернета: каталог с полным набором ONNX-весов.
# RUSSIAN_OCR_MODELS_SOURCE_DIR=/absolute/path/to/russian-ocr-models

# Qwen: используются только при включённой модели Qwen.
VLM_OCR_URL=http://127.0.0.1:8004
VLM_OCR_TIMEOUT_SECONDS=300
VLM_OCR_MAX_NEW_TOKENS=4096
QWEN_DEVICE=auto
HF_HOME=storage/vlm/huggingface
# VLM_LLAMA_SERVER_BIN=/absolute/path/to/llama-server

# QR-ключи создаёт ./install.sh.
# QR_ACTIVE_KEY_ID=primary
# QR_ENCRYPTION_KEYS=primary:<base64url-key>
QR_MAX_IMAGE_BYTES=26214400
QR_MAX_IMAGES_PER_REQUEST=3
API_QR_MAX_REQUEST_BODY_SIZE_MB=76

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr
POSTGRES_DB=ocr

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Очередь и outbox
OCR_QUEUE_NAME=ocr.jobs
OCR_DLQ_NAME=ocr.jobs.dlq
OCR_QUEUE_MAX_SIZE=50
OCR_OUTBOX_POLL_INTERVAL_SECONDS=1
OCR_OUTBOX_BATCH_SIZE=20
OCR_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OCR_OUTBOX_MAX_RETRY_DELAY_SECONDS=60

# Загрузки и проверка изображений
OCR_MAX_IMAGE_SIZE_MB=75
OCR_MAX_IMAGES_PER_REQUEST=3
API_MAX_REQUEST_BODY_SIZE_MB=226
OCR_MAX_IMAGE_WIDTH=12000
OCR_MAX_IMAGE_HEIGHT=12000
OCR_MAX_IMAGE_PIXELS=50000000
OCR_QUALITY_MAX_SIDE=1600
OCR_STORAGE_DIR=storage/uploads
OCR_SAVE_UPLOADS=false

# Запуск и остановка OCR-движков
PADDLE_OCR_DOCUMENT_HARD_TIMEOUT_SECONDS=18
PADDLE_OCR_FULL_HARD_TIMEOUT_SECONDS=38
MRZ_SCANNER_DOCUMENT_HARD_TIMEOUT_SECONDS=18
RUSSIAN_OCR_DOCUMENT_HARD_TIMEOUT_SECONDS=18
PADDLE_OCR_STARTUP_TIMEOUT_SECONDS=300
MRZ_SCANNER_STARTUP_TIMEOUT_SECONDS=300
RUSSIAN_OCR_STARTUP_TIMEOUT_SECONDS=300
PADDLE_OCR_SHUTDOWN_TIMEOUT_SECONDS=1
MRZ_SCANNER_SHUTDOWN_TIMEOUT_SECONDS=1
RUSSIAN_OCR_SHUTDOWN_TIMEOUT_SECONDS=1

# Задачи и worker
OCR_RESULT_TTL_SECONDS=86400
OCR_CLEANUP_INTERVAL_SECONDS=300
OCR_MAX_ATTEMPTS=2
OCR_RETRY_DELAY_SECONDS=3
OCR_WORKERS=1
OCR_WORKER_STARTUP_TIMEOUT_SECONDS=30
OCR_WORKER_LEASE_SECONDS=30
OCR_WORKER_HEARTBEAT_SECONDS=5
OCR_LEASE_RECOVERY_INTERVAL_SECONDS=10
OCR_QUEUED_WATCHDOG_INTERVAL_SECONDS=10
OCR_QUEUED_WATCHDOG_STALE_SECONDS=60

# Логи
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
